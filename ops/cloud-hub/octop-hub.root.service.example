# Example unit for cloud box running as root (repo /root/octopus).
# Install: sudo cp ops/cloud-hub/octop-hub.root.service.example /etc/systemd/system/octop-hub.service
# Prefer: sudo ./ops/cloud-hub/install-hub.sh --user root --repo /root/octopus --home /root/OctopData

[Unit]
Description=Octopus cloud hub (octop)
Documentation=file:docs/octopus/cloud-hub-ops.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/octopus
Environment="HOME=/root"
Environment=OCTOP_HOME=/root/OctopData
Environment=OCTOP_BIND_HOST=0.0.0.0
Environment=OCTOP_PORT=8188
Environment=OCTOP_SERVICE_MODE=systemd
Environment=PATH=/root/.local/bin:/usr/bin:/bin
ExecStart=/root/.local/bin/uv run octop run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
