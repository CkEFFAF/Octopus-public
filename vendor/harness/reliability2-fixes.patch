+def _read_limited_body(response: httpx.Response) -> bytes:
+    """Bound decoder output too, rather than allocating a complete gzip member."""
+    encoding = response.headers.get("content-encoding", "identity").strip().lower()
+    if encoding not in {"identity", "gzip", "deflate"}:
+        raise httpx.DecodingError(f"Unsupported content encoding: {encoding}")
+    decoder = zlib.decompressobj(16 + zlib.MAX_WBITS) if encoding == "gzip" else None
+    body = bytearray()
+    prefix = b""
+    try:
+        for raw_chunk in response.iter_raw():
+            chunk = raw_chunk
+            if encoding == "deflate" and decoder is None:
+                prefix += chunk
+                if len(prefix) < 2:
+                    continue
+                # HTTP deflate can contain a zlib wrapper or a raw deflate stream.
+                wrapped = prefix[0] & 15 == 8 and int.from_bytes(prefix[:2], "big") % 31 == 0
+                decoder = zlib.decompressobj(zlib.MAX_WBITS if wrapped else -zlib.MAX_WBITS)
+                chunk = prefix
+            if decoder is not None and decoder.eof:
+                raise httpx.DecodingError("Unexpected data after compressed response")
+            decoded = decoder.decompress(chunk, _MAX_BYTES - len(body) + 1) if decoder else chunk
+            if len(body) + len(decoded) > _MAX_BYTES:
+                raise FetchResponseTooLargeError(f"web_fetch response is exceeding the {_MAX_BYTES}-byte cap.")
+            body.extend(decoded)
+            if decoder is not None and decoder.unused_data:
