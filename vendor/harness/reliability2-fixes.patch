+"""Forced compaction isolates mutable policy and counts the full request context."""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from deepagents.middleware.summarization import SummarizationMiddleware
+from langchain_core.messages import HumanMessage
+from tests.test_compaction import _long_thread, _summary_model, _workspace_backend
+
+from octop_harness.compaction import FORCE_KEEP_MESSAGES, _persist_compact_event, force_compact_thread
+from octop_harness.context_usage import conversation_tokens_from_messages, estimate_tokens
+from octop_harness.middleware.memory_recall import (
+    replay_context_snapshots,
+    replay_recall_snapshots,
+    stamp_context_snapshot,
+    stamp_recall_snapshot,
+)
+
+
+@pytest.mark.asyncio
+async def test_parallel_force_compactions_keep_models_and_graph_policy_isolated(tmp_path) -> None:
+    backend = _workspace_backend(tmp_path)
+    original_model = _summary_model("original")
+    models = {"A": _summary_model("summary A"), "B": _summary_model("summary B")}
+    graph_mw = SummarizationMiddleware(
+        model=original_model,
+        backend=backend,
+        trigger=("tokens", 100_000),
+        keep=("messages", 20),
+        summary_prompt="custom summary: {messages}",
+        trim_tokens_to_summarize=1234,
+    )
+    helper = graph_mw._lc_helper
+    original_summary_model = helper._summary_model
+    messages = _long_thread(8)
+    graph = MagicMock()
+    graph.aget_state = AsyncMock(
+        side_effect=lambda config: SimpleNamespace(
+            values={
+                "messages": messages,
+                "_summarization_session_id": f"session_{config['configurable']['thread_id']}",
+            }
+        )
+    )
+    graph.aupdate_state = AsyncMock()
+    started = {name: asyncio.Event() for name in models}
+    release = {name: asyncio.Event() for name in models}
+    seen = {}
+    offloads = []
+
+    async def summarize(mw, _messages):
+        name = next(name for name, model in models.items() if mw.model is model)
+        started[name].set()
+        await release[name].wait()
+        seen[name] = (
+            mw.model,
+            mw._lc_helper.keep,
+            mw._lc_helper.summary_prompt,
+            mw._lc_helper.trim_tokens_to_summarize,
+        )
+        return f"summary {name}"
+
+    async def offload(_mw, target, _messages, session_id):
+        offloads.append((target, session_id))
+        return f"/conversation_history/{session_id}.md"
+
+    with (
+        patch.object(SummarizationMiddleware, "_acreate_summary", summarize),
+        patch.object(SummarizationMiddleware, "_aoffload_to_backend", offload),
+    ):
+        tasks = {}
+        try:
+            for name, model in models.items():
+                tasks[name] = asyncio.create_task(
+                    force_compact_thread(
+                        graph=graph,
+                        backend=MagicMock(),
+                        model=model,
+                        thread_id=name,
+                        summarization_middleware=graph_mw,
+                    )
+                )
+                await asyncio.wait_for(started[name].wait(), 2)
+            observed_graph_policy = (helper.model, helper.keep, helper._summary_model)
+            release["A"].set()
+            assert (await tasks["A"]).ok
+            release["B"].set()
+            assert (await tasks["B"]).ok
+        finally:
