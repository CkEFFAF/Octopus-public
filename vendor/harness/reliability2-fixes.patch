+def mcp_args_model(tool_name: str, input_schema: dict[str, Any]) -> dict[str, Any]:
+    """Copy MCP ``inputSchema`` for LangChain's native JSON Schema args support.
+
+    The historical helper name is retained, but the return value is now a schema
+    dictionary, not a Pydantic class. This preserves references, constraints and
+    property names without compiling an incomplete subset of JSON Schema. The
+    MCP server remains responsible for argument validation.
+    """
+    del tool_name
+    return deepcopy(input_schema)
+
+
+def _forbids_null(spec: Any, root: dict[str, Any], refs: frozenset[str] = frozenset()) -> bool:
+    """Recognize nonnullable properties conservatively; unknown schemas stay intact."""
+    if not isinstance(spec, dict):
+        return spec is False
+    kind = spec.get("type")
+    if (
+        (isinstance(kind, str) and kind != "null")
+        or (isinstance(kind, list) and "null" not in kind)
+        or ("enum" in spec and None not in spec["enum"])
+        or ("const" in spec and spec["const"] is not None)
+        or any(_forbids_null(item, root, refs) for item in spec.get("allOf", []))
+    ):
+        return True
+    for key in ("anyOf", "oneOf"):
+        variants = spec.get(key)
+        if isinstance(variants, list) and variants and all(_forbids_null(item, root, refs) for item in variants):
