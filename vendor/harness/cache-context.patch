+def cache_metrics_reported(raw: Mapping[str, Any]) -> bool:
+    """Whether an actual cache-read counter was supplied, including zero."""
+    if raw.get("cache_metrics_reported") is False:
+        return False
+
+    def valid(value: Any) -> bool:
+        if value is None or isinstance(value, bool):
+            return False
+        try:
+            return int(value) >= 0
+        except (TypeError, ValueError, OverflowError):
+            return False
+
+    if any(valid(raw.get(key)) for key in ("cache_read_tokens", "prompt_cache_hit_tokens")):
+        return True
+    details = raw.get("input_token_details") or raw.get("prompt_tokens_details") or {}
+    return isinstance(details, Mapping) and any(
+        isinstance(key, str)
+        and any(key == name or key.endswith(f"_{name}") for name in ("cache_read", "cached_tokens"))
+        and valid(value)
+        for key, value in details.items()
+    )
 
 
