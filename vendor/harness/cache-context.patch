 from langchain_core.messages.utils import MessageLikeRepresentation, convert_to_messages, count_tokens_approximately
 
 RECALL_SNAPSHOT_KEY = "_octop_memory_recall"
+CONTEXT_SNAPSHOTS_KEY = "_octop_request_contexts"
+
+
+def context_snapshot_suffixes(message: HumanMessage) -> list[tuple[str, str]]:
+    """Read validated host contexts, bound to the original message content."""
+    snapshots = message.additional_kwargs.get(CONTEXT_SNAPSHOTS_KEY)
+    if not isinstance(snapshots, dict):
+        return []
+    fingerprint = _content_hash(message.content)
+    result: list[tuple[str, str]] = []
+    for namespace in sorted(key for key in snapshots if isinstance(key, str)):
+        snapshot = snapshots[namespace]
+        if (
+            isinstance(snapshot, dict)
+            and snapshot.get("version") == 1
+            and snapshot.get("content_hash") == fingerprint
+            and isinstance(snapshot.get("suffix"), str)
+        ):
+            result.append((namespace, snapshot["suffix"]))
+    return result
+
+
+def has_context_snapshot(message: HumanMessage, namespace: str) -> bool:
+    return any(key == namespace for key, _ in context_snapshot_suffixes(message))
+
+
+def stamp_context_snapshot(message: HumanMessage, namespace: str, suffix: str) -> HumanMessage:
+    snapshots = message.additional_kwargs.get(CONTEXT_SNAPSHOTS_KEY)
+    snapshots = dict(snapshots) if isinstance(snapshots, dict) else {}
+    snapshots[namespace] = {"version": 1, "content_hash": _content_hash(message.content), "suffix": suffix}
+    return message.model_copy(
+        update={"additional_kwargs": {**message.additional_kwargs, CONTEXT_SNAPSHOTS_KEY: snapshots}}
+    )
+
+
+def replay_context_snapshots(
+    messages: list[AnyMessage],
+    *,
+    originals: list[AnyMessage] | None = None,
+    namespace: str | None = None,
+) -> list[AnyMessage]:
+    """Replay host data on API copies after recall, keeping both budgets exact.
+
+    Originals are clean checkpoint messages. The API copies may already carry
+    independently rendered recall or another namespace. IDs associate them;
+    positional matching covers idless inputs in standalone token counting.
+    """
+    by_id = {item.id: item for item in originals or [] if isinstance(item, HumanMessage) and item.id is not None}
+    result: list[AnyMessage] = []
+    for index, message in enumerate(messages):
+        if not isinstance(message, HumanMessage):
+            result.append(message)
+            continue
+        original = by_id.get(message.id) if message.id is not None else None
+        if (
+            original is None
+            and message.id is None
+            and originals
+            and index < len(originals)
+            and isinstance(originals[index], HumanMessage)
+        ):
+            original = cast(HumanMessage, originals[index])
+        original = original or message
+        if CONTEXT_SNAPSHOTS_KEY not in original.additional_kwargs:
+            result.append(message)
+            continue
+        suffixes = [
+            suffix for key, suffix in context_snapshot_suffixes(original) if namespace is None or key == namespace
+        ]
+        copy = message.model_copy(deep=True)
+        copy.additional_kwargs.pop(CONTEXT_SNAPSHOTS_KEY, None)
+        for suffix in suffixes:
+            if suffix:
+                copy.content = (
+                    copy.content + suffix
+                    if isinstance(copy.content, str)
+                    else [*copy.content, {"type": "text", "text": suffix}]
+                )
+        result.append(copy)
+    return result
 
 
 def _content_hash(content: Any) -> str:
@@ -83,4 +163,5 @@
 def count_tokens_with_recall(messages: Iterable[MessageLikeRepresentation], **kwargs: Any) -> int:
     """Include durable recall when upstream compaction counts clean state messages."""
     normalized = cast(list[AnyMessage], convert_to_messages(messages))
-    return count_tokens_approximately(replay_recall_snapshots(normalized), **kwargs)
+    replayed = replay_context_snapshots(replay_recall_snapshots(normalized), originals=normalized)
+    return count_tokens_approximately(replayed, **kwargs)
