--- /dev/null
+++ b/tests/test_task_result_terminal.py
@@ -0,0 +1,25 @@
+"""A failed terminal persistence cannot acknowledge a business result."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from octop_harness.teams.team_manager import TeamManager
+from octop_harness.teams.util import DispatchReceipt
+
+
+@pytest.mark.asyncio
+async def test_failed_terminal_save_clears_business_outcome() -> None:
+    team = TeamManager(MagicMock())
+    team.bind_peer_session(lifecycle=AsyncMock(side_effect=RuntimeError("save failed")))
+    receipt = await team._observe_peer(
+        SimpleNamespace(invocation_id="result-test"),
+        DispatchReceipt(invocation_id="result-test", transport_status="completed", task_outcome="succeeded"),
+        terminal=True,
+    )
+    assert receipt.transport_status == "unknown"
+    assert receipt.task_outcome == "unknown"
+    assert receipt.error_code == "PEER_RECEIPT_PERSISTENCE_FAILED"
